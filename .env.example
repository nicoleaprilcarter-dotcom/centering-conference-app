# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If you deploy without these set, the app falls back to an in-app
# "Connect your database" screen that stores the same two values in
# the visitor's browser instead.

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
